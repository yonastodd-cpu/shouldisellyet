__pycache__/
.pytest_cache/
*.pyc
.DS_Store

# Raw source snapshots — kept as workflow artifacts, never committed
# (the Redfin tracker alone is ~1.5GB). See docs/DATA.md.
archive/

# Supabase CLI local state (written by `supabase link` / `functions deploy`).
# Machine-specific, and the CLI also caches credentials here on some flows —
# never commit it.
supabase/.temp/

# Vendor-derived records pulled out of the public repo (Prompt 1). RETAINED,
# not deleted — legal review wants retention, so this is moved to private
# storage by hand rather than removed. Never commit it back.
_private_data_export/

# Generated at deploy time by pipeline/provision_readings.py from the
# committed page manifest, plus readings for released tranches pulled from the
# private store. Was committed source carrying per-ZIP vendor metrics for
# 28,000+ ZIPs — and because the whole of web/ is the deployed artifact, it
# was also a public bulk-download endpoint at /data/zips/{ST}.json regardless
# of whether any page linked it.
web/data/zips/

# Generated at deploy time by pipeline/build_pages.py from committed web/data.
# ~18.6k pages / 147MB — never committed (9.8MB gzipped in the Pages artifact).
web/zip/
web/sitemaps/
web/sitemap.xml
web/robots.txt
web/llms.txt
web/og/

web/verdict-copy.js
web/s/

# Generated at deploy time by pipeline/build_research.py from committed
# pipeline/research JSONs — pages, charts, CSVs.
web/research/

# Generated at deploy time by pipeline/post_pack.py from the committed
# pack manifest — one card per marketing task. Public by design (they are
# destined for public feeds) but never committed: they are re-rendered from
# the manifest on every deploy, deterministically.
web/assets/mkt/

# Generated at deploy time by pipeline/post_pack.py — one static redirect
# per marketing task, so the short link in a caption carries the campaign
# token the nightly performance join reads.
web/go/

# Generated at deploy time by pipeline/build_metro.py — one page per metro
# area, plus the hub and the /methodology short route.
web/metro/

# Generated at deploy time by pipeline/build_stories.py from the committed
# case JSONs. Like web/metro/ and web/go/, absent from a fresh checkout.
web/stories/
web/methodology/

# Per-ZIP velocity payloads — the PAID layer. Served only through
# verify-access (Supabase); committing them would publish the paid feature in
# a public repo. The aggregate velocity-{month}.json files ARE committed.
pipeline/velocity/zip-velocity-latest.json

# Raw Redfin sources cached by tools/backtest_cases.py (~1GB). The COMPUTED
# case JSONs in web/data/cases/ are committed; their inputs are not.
.cache/

# Read-only exposure audit — names every sensitive path and commit in one
# place. Kept local; publishing it would publish the map.
AUDIT_REPORT.md
